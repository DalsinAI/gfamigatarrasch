 }
 
+#ifdef THC_AMIGA
+// AmigaOS: the engine is an AmigaDOS process joined by PIPE: channels
+//  (compat/tarrasch_amiga_engine.c); there are no file descriptors
+static int mac_fd_read;
+static int mac_fd_write;
+
+unsigned long GetTickCount()
+{
+    return tarrasch_ticks_ms();
+}
+
+void Sleep( int ms )
+{
+    tarrasch_sleep_ms( ms );
+}
+
+int MacReadNonBlocking( int fd, char *buf, int max )
+{
+    (void)fd;
+    return tarrasch_engine_read( buf, max );
+}
+
+void MacWrite( int fd, const char *buf )
+{
+    (void)fd;
+    tarrasch_engine_write( buf );
+}
+
+#else
 static int mac_fd_read;
 static int mac_fd_write;
 
@@ -148,6 +181,8 @@ void MacWrite( int fd, const char *buf )
 }
 
 
+#endif // THC_AMIGA
