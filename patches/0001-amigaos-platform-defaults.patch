diff --git a/src/Portability.h b/src/Portability.h
index b252e6d..abf9169 100644
--- a/src/Portability.h
+++ b/src/Portability.h
@@ -17,6 +17,12 @@
 #elif defined __WXOSX__
     #define THC_MAC
     #define THC_UNIX
+#elif defined __AMIGA__
+    // AmigaOS (GFOS) on the GFOpenWX Toolkit: the Linux code paths, with
+    //  the engine link of UnixUciInterface.cpp done the AmigaOS way
+    #define THC_LINUX
+    #define THC_UNIX
+    #define THC_AMIGA
 #else
     #error "Unknown target platform - not Windows, Linux GTK or OSX"
 #endif
diff --git a/src/fseek64.h b/src/fseek64.h
index 54bbb9f..95865c0 100644
--- a/src/fseek64.h
+++ b/src/fseek64.h
@@ -18,7 +18,14 @@ inline int64_t ftell64( FILE *file )
     { return _ftelli64( file); }
 #endif
 
-#ifdef THC_UNIX
+#ifdef THC_AMIGA
+// AmigaOS files stay under 2 GB: plain fseek() and ftell()
+inline int fseek64( FILE *file, int64_t fposn, int origin )
+    { return fseek( file, (long)fposn, origin ); }
+
+inline int64_t ftell64( FILE *file )
+    { return ftell( file); }
+#elif defined THC_UNIX
 inline int fseek64( FILE *file, int64_t fposn, int origin )
     { return _fseeko( file, fposn, origin ); }
 
